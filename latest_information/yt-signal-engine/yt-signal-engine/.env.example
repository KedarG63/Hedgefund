# Copy to .env and fill in.

# Required: used for the extraction pass.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Only needed if you enable a proxy in transcripts.py because your IP
# is getting rate-limited by YouTube (common on VPS / datacenter IPs, rare on a
# home connection).
# YT_PROXY_HTTP=http://user:pass@host:port
# YT_PROXY_HTTPS=http://user:pass@host:port
