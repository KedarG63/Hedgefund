# quantdata settings -- copy to .env and fill in.
# .env is gitignored. Never commit real values. Session cookies pasted into
# chat or docs are burned; rotate them.

# ------------------------------------------------------------------ storage
# Where the raw archive, parquet warehouse and duckdb file live.
# Relative paths resolve against the process working directory.
QUANTDATA_ROOT=./data

# ------------------------------------------------------------------ SEC EDGAR
# REQUIRED for any SEC job. EDGAR returns 403 without a contact email in the
# User-Agent. Free, no registration -- it just has to be a real address.
SEC_CONTACT_EMAIL=CHANGEME@example.com

# ------------------------------------------------------------------ broker (Phase 6 / live layer)
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

# ------------------------------------------------------------------ redis (live tick cache)
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------ alerting (Phase 6)
# A job that silently stops running looks exactly like a market with no news.
ALERT_WEBHOOK_URL=
ALERT_EMAIL_TO=

# ------------------------------------------------------------------ DeepSeek (Phase 7 digest)
# Only used by analytics/digest.py, via DeepSeek's Anthropic-API-compatible
# endpoint. This is the ONE place an LLM is called anywhere in the analytics
# engine -- every actual signal (beta, momentum, Greeks, correlation) is
# deterministic math computed before this key is ever touched.
DEEPSEEK_API_KEY=

# ------------------------------------------------------------------ Phase 7: OSINT / geospatial
# Most of this layer needs NO credentials at all: IMF PortWatch (chokepoint
# transits), NOAA ONI + CPC (ENSO and rainfall), GDELT, GDACS, USGS, EONET and
# NVD are all keyless and verified live. Only the three below need anything.

# OpenSky Network -- OAuth2 CLIENT CREDENTIALS, not username/password (they
# migrated in 2025). Create a client at opensky-network.org > Account.
# connectors/flights.py reads these case-insensitively, so the alternate
# spelling Opensky_clientId / Opensky_clientSecret also resolves -- os.environ
# is case-insensitive on Windows but NOT on Linux, so prefer these names for
# anything that will ever run on a server.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# NASA FIRMS active-fire detections. Free self-service key:
# https://firms.modaps.eosdis.nasa.gov/api/area/
# NOT YET VERIFIED -- connectors/climate.py:firms_hotspots() has never run
# successfully on this machine, because no key was available. The endpoint
# SHAPE is confirmed (a bad key returns "Invalid MAP_KEY"), but the CSV parse
# is written against documented columns, not an observed response. Check the
# first real call before trusting it.
FIRMS_MAP_KEY=

# IMD (India Meteorological Department).
# NOT REQUIRED for the gridded rainfall this project actually uses.
# connectors/imd.py downloads IMD's own 0.25-degree daily gridded rainfall
# (1990-2025) from its public NetCDF form at imdpune.gov.in -- no key, no
# registration, no approval. The API approval that is still pending would add
# IMD's real-time/station endpoints, not the gridded archive, so leave this
# blank unless and until that approval arrives and you need those.
IMD_API_KEY=

# ------------------------------------------------------------------ screener.in (deliberate CLAUDE.md exception)
# DELIBERATE, SCOPED EXCEPTION to the no-third-party-vendors rule -- decided
# explicitly by the user 2026-08-30 after being shown the conflict, because
# NSE's own quarterly-results feed lags ~18 months for large caps (see
# connectors/nse_fundamentals.py) and no primary-source path to current
# CONSOLIDATED detail has been found. Internal research use only.
#
# A logged-in screener.in session, not an API key -- get both values by
# logging into screener.in, opening a company page, clicking "Export to
# Excel", and copying the request's cookies from DevTools > Network (or copy
# as cURL and read the -b flag). These expire; when connectors/screener.py
# starts failing with a 302-to-login, repeat this to get fresh values.
SCREENER_CSRFTOKEN=
SCREENER_SESSIONID=

# ------------------------------------------------------------------ Terminal API (Phase 2)
# Bearer token for api/main.py. This gates read access to the ENTIRE warehouse,
# so the service refuses to start without it rather than defaulting to open.
# Generate one and keep it out of git (.env is gitignored):
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
# uvicorn binds 127.0.0.1 as well -- exchange terms restrict redistribution, so
# exposing this off the machine is a licensing question before it is a
# networking one. See CLAUDE.md.
TERMINAL_TOKEN=

# Where run_daily.py sends its "re-register views" ping when a run finishes.
# Defaults to http://127.0.0.1:8787 -- only set this if you moved the port.
# The ping is best effort: a collection run never fails because no terminal
# happened to be open.
TERMINAL_API_URL=
