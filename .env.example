# quantdata settings -- copy to .env and fill in.
# .env is gitignored. Never commit real values. Session cookies pasted into
# chat or docs are burned; rotate them.

# ------------------------------------------------------------------ storage
# Where the raw archive, parquet warehouse and duckdb file live.
# Relative paths resolve against the process working directory.
QUANTDATA_ROOT=./data

# ------------------------------------------------------------------ SEC EDGAR
# REQUIRED for any SEC job. EDGAR returns 403 without a contact email in the
# User-Agent. Free, no registration -- it just has to be a real address.
SEC_CONTACT_EMAIL=CHANGEME@example.com

# ------------------------------------------------------------------ broker (Phase 6 / live layer)
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

# ------------------------------------------------------------------ redis (live tick cache)
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------ alerting (Phase 6)
# A job that silently stops running looks exactly like a market with no news.
ALERT_WEBHOOK_URL=
ALERT_EMAIL_TO=
